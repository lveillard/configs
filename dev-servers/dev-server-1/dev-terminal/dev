#!/usr/bin/python3
"""Small persistent terminal manager; each session lives in a private tmux server."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

HOME = Path.home()
ROOT = HOME / '.config/dev-terminal'
TMUX = ['/usr/bin/tmux', '-L', 'dev-sessions', '-f', str(ROOT/'tmux.conf')]

def tmux(*args, check=True):
    return subprocess.run([*TMUX,*args],capture_output=True,text=True,check=check)

def sessions():
    result=tmux('list-sessions','-F','#{session_name}\t#{session_windows}\t#{session_attached}\t#{@dev-profile}',check=False)
    return [line.split('\t') for line in result.stdout.splitlines()]

def choose(lines, prompt, header, preview=None, hotkeys=None, help_enabled=True):
    hotkeys=dict(hotkeys or {})
    if help_enabled: hotkeys['f1']='\0help'
    query=''
    while True:
        command=['fzf','--layout=reverse','--border=rounded','--padding=1,2',
                 '--border-label',' '+prompt+' ','--prompt','Buscar > ',
                 '--header-first','--header',header,'--no-multi','--cycle',
                 '--info=inline-right','--no-sort','--print-query','--query',query,
                 '--bind','double-click:accept',
                 '--color','bg:#17212b,bg+:#293b4b,fg:#c7d5e0,fg+:#ffffff,hl:#66d9b0,hl+:#66d9b0,border:#50738b,header:#9bb9cd,prompt:#66d9b0,pointer:#66d9b0,label:#66d9b0']
        if hotkeys: command += ['--expect',','.join(hotkeys)]
        if preview:
            command += ['--preview',preview,'--preview-label',' Detalles ',
                        '--preview-window','right:45%:wrap:<110(down:40%:wrap)']
        # fzf draws on stderr; leave it connected to the terminal, capture only the choice.
        result=subprocess.run(command,input='\n'.join(lines),stdout=subprocess.PIPE,text=True)
        if result.returncode != 0: return None
        output=result.stdout.splitlines()
        query=output[0] if output else ''
        key=output[1] if hotkeys and len(output)>1 else ''
        action=hotkeys.get(key)
        if action=='\0help':
            show_help()
            continue
        if action: return action
        index=2 if hotkeys else 1
        return output[index] if len(output)>index else None

